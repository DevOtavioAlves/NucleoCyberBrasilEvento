<%- include('partials/sidebar.ejs') %>

<<main class="main-content" style="grid-template-columns: 1fr;"> <div class="card ranking-card">
        <div>
            <h2 class="card-title" style="border: none; padding-left: 0; font-size: 1.8rem;">Ranking de Contribuidores</h2>
            <p>Veja quem são os alunos que mais se destacam na comunidade.</p>
        </div>

        <div class="filters-bar">
            <select name="curso">
                <option value="todos">Todos os Cursos</option>
                <option value="seguranca">Segurança da Informação</option>
                <option value="gti">Gestão de TI</option>
            </select>
            <select name="periodo">
